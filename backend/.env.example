# ─────────────────────────────────────────────────────────────────────────────
# MoveCash — variables d'environnement du backend
# Copier ce fichier en « .env » (jamais envoyé sur GitHub) et remplir les valeurs.
# ─────────────────────────────────────────────────────────────────────────────

# Port d'écoute de Node (celui vers lequel Nginx redirige api.movecash.site)
PORT=4000

# Base PostgreSQL
#   sur le VPS   : postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/NOM_BASE
#   chez Render  : « External Database URL » de la base (SSL activé automatiquement)
# Obligatoire : sans elle, le serveur refuse de démarrer.
# Un « ?sslmode=… » en fin d'URL est ignoré : utilisez DB_SSL ci-dessous.
# Mot de passe avec @ : / # ? → l'encoder (@ = %40, : = %3A, / = %2F, # = %23, ? = %3F).
DATABASE_URL=

# Forcer (true) ou couper (false) le SSL vers la base — facultatif, détecté sinon
# DB_SSL=

# Signature des sessions. Garder la même valeur (la changer déconnecte tout le monde).
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Envoi des codes de connexion par e-mail — resend.com → API Keys
# (le domaine movecash.site doit être vérifié dans Resend → Domains)
RESEND_API_KEY=

# « production » : cookies sécurisés, code de connexion absent des logs
NODE_ENV=production

# Notifications push. Générer UNE fois : npx web-push generate-vapid-keys
# Ne jamais les changer ensuite : tous les abonnements deviendraient invalides.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@movecash.site
